# =============================================================================
# Git Ignore - det-core
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.lib

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE, Editor & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Testing, Type Checking & Linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# det Root Workspace Runtime Artifacts
# (Generated when running 'det init', 'det sample-data', or pipelines in the repo root)
/catalog/
/pipelines/
/source_data/
/logs/
/docs/
/documentation/
/extensions/
/Sample Workspace/
/*.duckdb
/*.sqlite
/*.db

# Scratch and internal planning notes
/IMPLEMENTATION_PLAN.md
/scratch/
*.tmp
*.bak
/_site/
/demo_workspace/
media/linkedin/*.wav
media/linkedin/screen_record.mp4
media/linkedin/tts.ps1

